[{"id":"085d7fed123ba44cbd5e","text":"人非元氣安能與之久裴回","normalized":"人非元气安能与之久裴回","length":11,"author":"李白","title":"相和歌辭 日出行","dynasty":"唐","sourceFile":"全唐诗/poet.tang.1000.json","sourceIndex":77,"poemId":"08cf0ce8-bd26-4bab-a4d2-5bc43acf8376"},{"id":"1be049448576aa8d0d39","text":"嗟爾遠道之人胡爲乎來哉","normalized":"嗟尔远道之人胡为乎来哉","length":11,"author":"李白","title":"相和歌辭 蜀道難","dynasty":"唐","sourceFile":"全唐诗/poet.tang.1000.json","sourceIndex":264,"poemId":"e117d224-39ca-4eba-a047-0d36ce8b8c26","familiarity":1},{"id":"1e2322cbb3a629613d44","text":"爾獨不憶年年取我身上膏","normalized":"尔独不忆年年取我身上膏","length":11,"author":"元稹","title":"相和歌辭  董逃行","dynasty":"唐","sourceFile":"全唐诗/poet.tang.1000.json","sourceIndex":223,"poemId":"1d87134d-4841-48b3-bb14-cdefa15cfe99"},{"id":"23dba8fc35475df29660","text":"棄我去者昨日之日不可留","normalized":"弃我去者昨日之日不可留","length":11,"author":"李白","title":"宣州謝朓樓餞別校書叔雲","dynasty":"唐","sourceFile":"全唐诗/唐诗三百首.json","sourceIndex":323,"poemId":"5593d522-b820-4c06-bab6-0ab5a0fc1d46","familiarity":2},{"id":"625d37d0882fc01b9867","text":"又安能使他人之終不我奪","normalized":"又安能使他人之终不我夺","length":11,"author":"元稹","title":"相和歌辭 決絕[詞]三首 二","dynasty":"唐","sourceFile":"全唐诗/poet.tang.1000.json","sourceIndex":277,"poemId":"1fcf1381-8137-43b2-8863-bc92e00f50c8"},{"id":"7a335f339f48bd29ec63","text":"亂我心者今日之日多煩憂","normalized":"乱我心者今日之日多烦忧","length":11,"author":"李白","title":"宣州謝朓樓餞別校書叔雲","dynasty":"唐","sourceFile":"全唐诗/唐诗三百首.json","sourceIndex":323,"poemId":"5593d522-b820-4c06-bab6-0ab5a0fc1d46","familiarity":2},{"id":"a7cd44da1f3ea4b30a3e","text":"又不能展鳳皇麒麟之拳跼","normalized":"又不能展凤皇麒麟之拳跼","length":11,"author":"僧齊己","title":"相和歌辭  苦寒行","dynasty":"唐","sourceFile":"全唐诗/poet.tang.1000.json","sourceIndex":220,"poemId":"d74898fe-e94d-452c-a8c8-3b878f110d0f"},{"id":"d8e22435e029a2ce6e31","text":"朝不日出兮夜不見月與星","normalized":"朝不日出兮夜不见月与星","length":11,"author":"韓愈","title":"琴曲歌辭 拘幽操","dynasty":"唐","sourceFile":"全唐诗/poet.tang.1000.json","sourceIndex":523,"poemId":"86be8315-dc90-4cd4-a3fa-a5c44bfa3535"},{"id":"f1d7a73c4c7181732260","text":"一百二十鳳皇羅列含明珠","normalized":"一百二十凤皇罗列含明珠","length":11,"author":"韋應物","title":"橫吹曲辭 長安道","dynasty":"唐","sourceFile":"全唐诗/poet.tang.1000.json","sourceIndex":5,"poemId":"1ab8a232-27bf-4de3-b67c-28e4735fea7f"}]